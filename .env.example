# Salin berkas ini menjadi ".env" lalu isi nilainya, kemudian jalankan ulang server.
#
# Kedua bagian di bawah bersifat opsional dan tidak saling bergantung:
#  - Tanpa kunci AI, deskripsi properti memakai draf offline dan fitur gambar AI
#    menampilkan pesan bahwa kunci belum diatur.
#  - Tanpa konfigurasi Firebase, aplikasi tetap bisa dijelajahi dan dipakai, tetapi
#    pendaftaran serta masuk akun tidak tersedia.


# ---------------------------------------------------------------------------
# 1. Google Gemini — untuk penulisan deskripsi dan pembuatan gambar AI
# ---------------------------------------------------------------------------

# Ambil di https://aistudio.google.com/apikey
GEMINI_API_KEY=

# Opsional: timpa model bawaan.
# Google menonaktifkan model lama untuk kunci baru, jadi bila muncul error
# "no longer available to new users", ganti ke model yang lebih baru di bawah.
# Daftar model: https://ai.google.dev/gemini-api/docs/models
# GEMINI_TEXT_MODEL=gemini-3.1-flash-lite
# Model cadangan bila model utama sedang sibuk (dipisah koma).
# GEMINI_TEXT_FALLBACKS=gemini-3.5-flash-lite,gemini-3-flash-preview
# GEMINI_IMAGE_MODEL=gemini-3.1-flash-image
# Batas waktu per model sebelum beralih ke model cadangan (milidetik).
# GEMINI_TEXT_TIMEOUT_MS=25000
#
# Catatan penting soal gambar: model gambar Gemini TIDAK tersedia di Free Tier
# (kuotanya 0), dan kredit free trial $300 Google Cloud tidak bisa dipakai untuk
# Gemini API di AI Studio. Untuk gambar, pakai Cloudflare Workers AI di bawah.


# ---------------------------------------------------------------------------
# 1b. Cloudflare Workers AI — khusus pembuatan gambar, gratis
# ---------------------------------------------------------------------------
#
# Model gambar Gemini butuh billing; Workers AI tidak. Kuotanya 10.000 neuron
# per hari tanpa biaya dan tanpa kartu kredit.
#
# Cara mengisi:
#   a. Daftar gratis di https://dash.cloudflare.com
#   b. Buka menu "Workers AI" → "Use REST API"
#   c. Salin Account ID, lalu klik "Create a Workers AI API Token"
#   d. Tempel keduanya di bawah, jalankan ulang server
#
# Bila kedua penyedia diisi, Cloudflare yang dipakai. Paksa salah satu dengan
# IMAGE_PROVIDER=cloudflare atau IMAGE_PROVIDER=gemini.

CLOUDFLARE_ACCOUNT_ID=
CLOUDFLARE_API_TOKEN=

# Opsional: ganti model gambar (bawaan flux-2-klein-4b).
# CLOUDFLARE_IMAGE_MODEL=@cf/black-forest-labs/flux-2-klein-4b


# ---------------------------------------------------------------------------
# 1c. Cloudinary — penyimpanan foto listing permanen di cloud (gratis 25 GB)
# ---------------------------------------------------------------------------
#
# Agar foto listing dan pesanan tetap persisten saat server di-deploy ke hosting
# cloud seperti Render, Railway, Vercel, atau VPS tanpa volume disk persisten.
# Bila dikosongkan, server otomatis menyimpan foto di disk lokal (folder uploads/).
#
# Cara mengisi:
#   a. Daftar akun gratis di https://cloudinary.com
#   b. Buka Dashboard, salin "Cloud Name", "API Key", dan "API Secret"
#   c. Tempel ketiganya di bawah, lalu jalankan ulang server.
#
# Paksa driver penyimpanan: STORAGE_DRIVER=cloudinary atau STORAGE_DRIVER=local
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=
# STORAGE_DRIVER=cloudinary


# ---------------------------------------------------------------------------
# 2. Firebase Authentication — untuk daftar dan masuk akun
# ---------------------------------------------------------------------------
#
# Kalau bagian ini dikosongkan, aplikasi memakai konfigurasi bawaan di
# firebase-applet-config.json. Isi bagian ini bila ingin memakai proyek Firebase
# Anda sendiri: buat proyek di https://console.firebase.google.com, tambahkan
# aplikasi web, lalu salin nilainya dari Project settings → Your apps.
#
# Jangan lupa di Firebase Console:
#   a. Authentication → Sign-in method → aktifkan "Email/Password"
#      (dan "Google" bila ingin tombol masuk dengan Google).
#   b. Authentication → Settings → Authorized domains → tambahkan "localhost"
#      dan domain tempat aplikasi ini nanti disajikan.

VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_STORAGE_BUCKET=
VITE_FIREBASE_MESSAGING_SENDER_ID=
VITE_FIREBASE_APP_ID=

# Opsional: hanya untuk proyek yang memakai basis data Firestore bernama khusus.
# Untuk database bawaan, isi dengan (default) agar tidak memakai fallback
# firebase-applet-config.json.
# VITE_FIREBASE_FIRESTORE_DB=(default)

# Aktifkan sinkronisasi katalog Firestore. Biarkan kosong/local untuk mode lama.
# VITE_DATA_BACKEND=firestore


# ---------------------------------------------------------------------------
# 2b. Firebase App Check (opsional, disarankan untuk produksi)
# ---------------------------------------------------------------------------
#
# Memastikan Firestore dan endpoint AI/unggah hanya dipanggil dari aplikasi ini.
# Langkah:
#   a. Firebase Console → App Check → daftarkan aplikasi web dengan Fraud
#      Defense (reCAPTCHA Enterprise) dan tambahkan domain aplikasi.
#   b. Salin site key reCAPTCHA Enterprise ke VITE_FIREBASE_APP_CHECK_SITE_KEY.
#   c. Isi kredensial Firebase Admin (bagian 3b), lalu set APP_CHECK_REQUIRED=true.
#
# Untuk pengembangan lokal, buat debug token di App Check → Apps → Manage debug
# tokens. Jangan memakai debug token di produksi.

VITE_FIREBASE_APP_CHECK_SITE_KEY=
# VITE_FIREBASE_APP_CHECK_DEBUG_TOKEN=
# APP_CHECK_REQUIRED=false


# ---------------------------------------------------------------------------
# 3. Server
# ---------------------------------------------------------------------------

# Opsional: port server (bawaan 3000).
# PORT=3000

# Opsional: level log server: debug, info, warn, error, atau silent.
# LOG_LEVEL=info

# Opsional: kuota AI per akun (per menit dan per hari).
# AI_MINUTE_LIMIT=15
# AI_DAY_LIMIT=100

# Opsional: URL publik aplikasi untuk redirect setelah pembayaran.
# APP_URL=http://localhost:3000


# ---------------------------------------------------------------------------
# 3a. Pembayaran online (Midtrans Snap, opsional)
# ---------------------------------------------------------------------------
#
# Tanpa kunci ini, pesanan non-COD tetap bisa dibuat tetapi tombol bayar
# menampilkan pesan bahwa pembayaran online belum dikonfigurasi (HTTP 503).
# COD tetap berjalan seperti biasa.
#
#   a. Daftar di https://dashboard.midtrans.com dan buka Environment → Sandbox.
#   b. Salin Server Key ke MIDTRANS_SERVER_KEY (jangan pernah pakai di klien).
#   c. Daftarkan URL notifikasi:
#      https://domain-anda/api/payments/midtrans/webhook
#   d. Set MIDTRANS_IS_PRODUCTION=true saat memakai kunci produksi.

# MIDTRANS_SERVER_KEY=
# MIDTRANS_IS_PRODUCTION=false


# ---------------------------------------------------------------------------
# 3b. Firebase Admin — pembuatan pesanan (wajib di mode Firestore) dan kuota AI
# ---------------------------------------------------------------------------
#
# Mode Firestore membuat pesanan lewat POST /api/orders dengan Admin SDK agar
# harga, voucher, dan stok dihitung ulang di server. Tanpa kredensial ini
# endpoint tersebut membalas HTTP 503 dan checkout tidak bisa diselesaikan.
# Kredensial yang sama dipakai untuk kuota AI persisten di Firestore.
#
# Tanpa kredensial ini, kuota AI disimpan di memori server: ter-reset saat
# restart dan tidak dibagi antar-instance. Isi salah satu:
#   a. Tempel isi berkas service account (JSON satu baris) ke FIREBASE_SERVICE_ACCOUNT.
#   b. Atau isi path berkas JSON ke GOOGLE_APPLICATION_CREDENTIALS.
# Di Cloud Run/App Engine, application default credentials biasanya sudah ada.
#
# Lalu pilih backend kuota:
#   auto       — Firestore bila kredensial admin tersedia, jika tidak memori (bawaan)
#   firestore  — wajib Firestore (fallback ke memori bila tidak siap)
#   memory     — selalu memori
#
# FIREBASE_PROJECT_ID=
# FIREBASE_SERVICE_ACCOUNT={"type":"service_account","project_id":"...","private_key":"...","client_email":"..."}
# GOOGLE_APPLICATION_CREDENTIALS=C:\path\service-account.json
# AI_QUOTA_BACKEND=auto


# ---------------------------------------------------------------------------
# 4. Google Maps (opsional) — pengisian alamat otomatis dari titik GPS
# ---------------------------------------------------------------------------
#
# Dipakai untuk mengubah titik GPS menjadi alamat lengkap (reverse geocoding)
# dan mencari titik dari alamat yang diketik (geocoding).
#
# Cara mengisi:
#   a. Buka https://console.cloud.google.com/google/maps-apis
#   b. Aktifkan "Geocoding API".
#   c. Buat API key lalu tempel di bawah.
#
# Tanpa kunci ini aplikasi tetap berjalan: peta Google tetap tampil
# (embed tidak butuh kunci), titik GPS tetap tersimpan, dan reverse/geocode
# memakai fallback OpenStreetMap Nominatim. Alamat juga selalu bisa diisi
# manual. Jarak ke pembeli tetap dihitung selama titik lokasi tersedia.
#
# Catatan: variabel VITE_* ikut terbundel ke sisi klien, jadi batasi API key
# dengan "HTTP referrers" pada domain aplikasi Anda.

VITE_GOOGLE_MAPS_API_KEY=
