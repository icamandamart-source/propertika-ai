{
  "name": "propertika-ai",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "description": "Marketplace properti dengan AI Studio: deskripsi iklan otomatis, makeover ruangan, dan simulasi KPR.",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "dev": "tsx server.ts --dev",
    "build": "tsc --noEmit && vite build && esbuild server.ts --bundle --platform=node --format=esm --target=node20 --packages=external --outfile=server.js",
    "start": "node server.js",
    "preview": "vite preview",
    "test": "vitest run",
    "test:rules": "npx --yes firebase-tools emulators:exec --only firestore --project demo-propertika-rules \"vitest run tests/firestore-rules.test.ts\"",
    "midtrans:simulate": "node scripts/midtrans-simulate.mjs",
    "backup": "tsx scripts/backup-firestore.ts",
    "backup:restore": "tsx scripts/restore-firestore.ts",
    "test:watch": "vitest",
    "test:e2e": "playwright test",
    "typecheck": "tsc --noEmit",
    "lint": "tsc --noEmit"
  },
  "dependencies": {
    "@google/genai": "^2.4.0",
    "dotenv": "^17.2.3",
    "express": "^4.21.2",
    "firebase": "^13.2.0",
    "firebase-admin": "^14.5.1",
    "lucide-react": "^1.70.0",
    "react": "^19.0.1",
    "react-dom": "^19.0.1",
    "react-router-dom": "^7.18.5"
  },
  "devDependencies": {
    "@firebase/rules-unit-testing": "^6.0.0",
    "@playwright/test": "^1.65.0",
    "@tailwindcss/vite": "^4.3.3",
    "@types/express": "^4.17.21",
    "@types/node": "^22.14.0",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.1",
    "esbuild": "^0.28.0",
    "jsdom": "^29.1.1",
    "tailwindcss": "^4.3.3",
    "tsx": "^4.21.0",
    "typescript": "^7.0.2",
    "vite": "^8.3.0",
    "vitest": "^5.1.0"
  }
}
