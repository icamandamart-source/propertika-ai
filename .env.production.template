# =============================================================================
# PROPERTIKA AI - PRODUCTION ENVIRONMENT TEMPLATE
# =============================================================================
# Instruksi:
# 1. Copy file ini ke .env.production (atau set di dashboard Render/Railway)
# 2. Isi SEMUA nilai yang berkomentar "REQUIRED"
# 3. Optional: isi yang berkomentar "OPTIONAL" sesuai kebutuhan
# 4. JANGAN commit file .env yang berisi secret ke git!
# =============================================================================

# -----------------------------------------------------------------------------
# 1. FIREBASE CLIENT (REQUIRED - dari Firebase Console > Project Settings > General > Your Apps)
# -----------------------------------------------------------------------------
VITE_FIREBASE_API_KEY=YOUR_API_KEY_HERE
VITE_FIREBASE_AUTH_DOMAIN=YOUR_PROJECT_ID.firebaseapp.com
VITE_FIREBASE_PROJECT_ID=YOUR_PROJECT_ID
VITE_FIREBASE_STORAGE_BUCKET=YOUR_PROJECT_ID.firebasestorage.app
VITE_FIREBASE_MESSAGING_SENDER_ID=YOUR_SENDER_ID
VITE_FIREBASE_APP_ID=1:YOUR_SENDER_ID:web:YOUR_APP_ID

# Firestore mode (REQUIRED untuk production)
VITE_DATA_BACKEND=firestore
VITE_FIREBASE_FIRESTORE_DB=(default)

# -----------------------------------------------------------------------------
# 2. FIREBASE ADMIN / SERVER (REQUIRED untuk mode Firestore, orders, AI quota persisten)
# -----------------------------------------------------------------------------
# Generate: Firebase Console > Project Settings > Service Accounts > Generate new private key
# Paste ENTIRE JSON as ONE LINE (escape newlines as \n, quotes as \")
FIREBASE_SERVICE_ACCOUNT={"type":"service_account","project_id":"YOUR_PROJECT_ID","private_key_id":"...","private_key":"-----BEGIN PRIVATE KEY-----\nYOUR_PRIVATE_KEY\n-----END PRIVATE KEY-----\n","client_email":"firebase-adminsdk-xxxxx@YOUR_PROJECT_ID.iam.gserviceaccount.com","client_id":"...","auth_uri":"https://accounts.google.com/o/oauth2/auth","token_uri":"https://oauth2.googleapis.com/token","auth_provider_x509_cert_url":"https://www.googleapis.com/oauth2/v1/certs","client_x509_cert_url":"https://www.googleapis.com/robot/v1/metadata/x509/firebase-adminsdk-xxxxx%40YOUR_PROJECT_ID.iam.gserviceaccount.com","universe_domain":"googleapis.com"}

# AI Quota backend: 'firestore' (persisten) atau 'memory' (reset saat restart)
AI_QUOTA_BACKEND=firestore

# -----------------------------------------------------------------------------
# 3. AI - GOOGLE GEMINI (OPTIONAL - untuk deskripsi teks)
# -----------------------------------------------------------------------------
# Get: https://aistudio.google.com/apikey
GEMINI_API_KEY=YOUR_GEMINI_API_KEY_HERE

# Model text (opsional, default sudah bagus)
# GEMINI_TEXT_MODEL=gemini-3.1-flash-lite
# GEMINI_TEXT_FALLBACKS=gemini-3.5-flash-lite,gemini-3-flash-preview
# GEMINI_TEXT_TIMEOUT_MS=25000

# -----------------------------------------------------------------------------
# 4. AI IMAGES - CLOUDFLARE WORKERS AI (REQUIRED untuk generate gambar)
# -----------------------------------------------------------------------------
# GRATIS 10,000 neuron/hari, tidak perlu kartu kredit
# Get: https://dash.cloudflare.com > Workers AI > Use REST API
CLOUDFLARE_ACCOUNT_ID=YOUR_CLOUDFLARE_ACCOUNT_ID
CLOUDFLARE_API_TOKEN=YOUR_CLOUDFLARE_API_TOKEN

# Model gambar (opsional, default flux-2-klein-4b)
# CLOUDFLARE_IMAGE_MODEL=@cf/black-forest-labs/flux-2-klein-4b

# -----------------------------------------------------------------------------
# 5. CLOUDINARY - PENYIMPANAN FOTO PERMANEN (REQUIRED untuk production)
# -----------------------------------------------------------------------------
# GRATIS 25 GB storage, 25 GB bandwidth/bulan
# Get: https://cloudinary.com/console > Dashboard
CLOUDINARY_CLOUD_NAME=YOUR_CLOUD_NAME
CLOUDINARY_API_KEY=YOUR_API_KEY
CLOUDINARY_API_SECRET=YOUR_API_SECRET

# Force driver: 'cloudinary' (default kalau kredensial ada) atau 'local'
# STORAGE_DRIVER=cloudinary

# -----------------------------------------------------------------------------
# 6. MIDTRANS PAYMENT (OPTIONAL - COD jalan tanpa ini)
# -----------------------------------------------------------------------------
# Get: https://dashboard.midtrans.com > Settings > Access Keys (Sandbox dulu)
# MIDTRANS_SERVER_KEY=SB-Mid-server-YOUR_SERVER_KEY
# MIDTRANS_IS_PRODUCTION=false
# APP_URL=https://your-app.onrender.com  # Akan diisi otomatis setelah deploy pertama

# -----------------------------------------------------------------------------
# 7. FIREBASE APP CHECK (OPTIONAL tapi DIREKOMENDASIKAN production)
# -----------------------------------------------------------------------------
# Setup: Firebase Console > App Check > Add App > Web > Fraud Defense (reCAPTCHA Enterprise)
# VITE_FIREBASE_APP_CHECK_SITE_KEY=YOUR_RECAPTCHA_ENTERPRISE_SITE_KEY
# APP_CHECK_REQUIRED=false  # Set true SETELAH deploy + custom domain ready

# Debug token untuk local development (JANGAN di production)
# VITE_FIREBASE_APP_CHECK_DEBUG_TOKEN=YOUR_DEBUG_TOKEN

# -----------------------------------------------------------------------------
# 8. SERVER SETTINGS
# -----------------------------------------------------------------------------
PORT=3000
LOG_LEVEL=info

# AI Rate Limits per account
AI_MINUTE_LIMIT=15
AI_DAY_LIMIT=100

# -----------------------------------------------------------------------------
# 9. GOOGLE MAPS (OPTIONAL - untuk geocoding otomatis)
# -----------------------------------------------------------------------------
# Get: https://console.cloud.google.com/google/maps-apis > Enable Geocoding API > Credentials
# Batasi API Key dengan HTTP referrers: https://your-domain.com/*
# VITE_GOOGLE_MAPS_API_KEY=YOUR_GOOGLE_MAPS_API_KEY

# =============================================================================
# CATATAN PENTING:
# =============================================================================
# - Variabel VITE_* akan terbundle ke frontend (client-side visible)
# - Variabel TANPA VITE_* HANYA di server (secret)
# - FIREBASE_SERVICE_ACCOUNT HARUS one-line JSON valid
# - Setelah deploy pertama, update APP_URL ke URL production Anda
# - Aktifkan APP_CHECK_REQUIRED=true HANYA setelah App Check configured
# =============================================================================